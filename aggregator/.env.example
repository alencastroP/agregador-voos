# Copie para .env para rodar fora do Docker (npm run dev).
# Dentro do docker compose, as URLs usam o nome do serviço e a porta interna 3000.
NODE_ENV=development
PORT=8000
LOG_LEVEL=info
APP_VERSION=0.1.0
# Graceful shutdown: readiness cai, espera isto (LB tira a instância), depois fecha
SHUTDOWN_GRACE_MS=0

# Tracing (make obs sobe o Jaeger; OTLP/HTTP exposto em 127.0.0.1:4318). Vazio = desligado.
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_SERVICE_NAME=flight-aggregator

# Providers (obrigatórias: o processo não sobe sem elas)
PROVIDER_A_URL=http://localhost:3001/provider-a/search
PROVIDER_B_URL=http://localhost:3002/provider-b/search
PROVIDER_C_URL=http://localhost:3003/provider-c/search
# Orçamento TOTAL por provider, incluindo retries (requisito: 3 s)
PROVIDER_TIMEOUT_MS=3000

# Retry dentro do orçamento acima: tentativas de 1 s (abandona chamada pendurada), backoff com jitter
PROVIDER_ATTEMPT_TIMEOUT_MS=1000
PROVIDER_MAX_ATTEMPTS=3
RETRY_BASE_DELAY_MS=50
RETRY_MAX_DELAY_MS=250
RETRY_MIN_ATTEMPT_MS=500

# Circuit breaker por provider (conta CHAMADAS LÓGICAS, já com retry)
CB_WINDOW_SIZE=20
CB_MINIMUM_CALLS=10
CB_FAILURE_RATE=0.5
CB_OPEN_DURATION_MS=10000

# Cache: resposta completa 5 min (requisito); parcial só 30 s (0 = não cacheia parcial)
CACHE_TTL_SECONDS=300
PARTIAL_CACHE_TTL_SECONDS=30
# Redis (docker compose expõe em 127.0.0.1:6379). Sem REDIS_URL: cache em memória (só dev).
REDIS_URL=redis://localhost:6379
REDIS_COMMAND_TIMEOUT_MS=200

# Persistência analítica (Postgres do compose em 127.0.0.1:5432). Vazio = sem insights.
DATABASE_URL=postgres://aggregator:aggregator@localhost:5432/aggregator
DB_POOL_MAX=5
DB_MIGRATE_ON_BOOT=true
DB_MAX_IN_FLIGHT_WRITES=200

# Validação da busca
BUSINESS_TIMEZONE=America/Sao_Paulo
SEARCH_MAX_DAYS_AHEAD=365

# Feature flags (OpenFeature, arquivo com recarga a quente). Vazio = só os defaults abaixo.
# Override pontual por env: FLAG_<CHAVE> (ex.: FLAG_PROVIDER_C_ENABLED=false)
FLAGS_FILE=../flags/flags.json
FLAGS_POLL_MS=2000

# Estratégia de seleção (defaults; feature flags podem sobrescrever em runtime)
SELECTION_STRATEGY=balanced
SELECTION_TOLERANCE_BPS=150
SELECTION_MAX_DELTA_CENTS=2500
SELECTION_MIN_GAIN_RATIO=0
