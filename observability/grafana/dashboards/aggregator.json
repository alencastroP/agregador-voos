    {
      "type": "stat",
      "title": "Incentivo a mais vs. 'sempre o mais barato'",
      "description": "Quanto a estratégia rende a mais do que exibir sempre a oferta mais barata (soma das ofertas exibidas, R$).",
      "id": 2,
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "postgres"
      },
      "gridPos": {
        "h": 5,
        "w": 5,
        "x": 0,
        "y": 1
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "postgres"
          },
          "refId": "A",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT coalesce(sum(o.incentive_gain_vs_cheapest_cents), 0) / 100.0 AS ganho FROM selected_offers o JOIN searches s ON s.id = o.search_id WHERE $__timeFilter(s.requested_at)"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "center"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "currencyBRL",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "decimals": 2
        },
        "overrides": []
      }
    },
    {
