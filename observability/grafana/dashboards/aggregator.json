    {
      "type": "stat",
      "title": "R$ do cliente por R$ 1 ganho",
      "description": "Custo do cliente ÷ ganho da empresa. Abaixo de 1 = ganha-ganha; a 'max_incentive' fica em ~3,3.",
      "id": 4,
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "postgres"
      },
      "gridPos": {
        "h": 5,
        "w": 4,
        "x": 10,
        "y": 1
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "postgres"
          },
          "refId": "A",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT sum(o.customer_delta_cents)::numeric / nullif(sum(o.incentive_gain_vs_cheapest_cents), 0) AS razao FROM selected_offers o JOIN searches s ON s.id = o.search_id WHERE $__timeFilter(s.requested_at)"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
