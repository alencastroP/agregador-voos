        },
        "overrides": []
      }
    },
    {
      "type": "stat",
      "title": "Voos em que a escolha ≠ mais barato",
      "description": "% das ofertas exibidas em que a estratégia não mostrou a mais barata (balanced ≈ 17%, max_incentive ≈ 58%).",
      "id": 5,
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "postgres"
      },
      "gridPos": {
        "h": 5,
        "w": 5,
        "x": 14,
        "y": 1
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "postgres"
          },
          "refId": "A",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT 100.0 * avg((o.customer_delta_cents > 0)::int) AS pct FROM selected_offers o JOIN searches s ON s.id = o.search_id WHERE $__timeFilter(s.requested_at)"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
