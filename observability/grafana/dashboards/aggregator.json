            "uid": "postgres"
          },
          "refId": "A",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT origin || ' → ' || destination AS \"rota\",\n       count(*) AS \"buscas\",\n       round(avg(travel_date - (requested_at AT TIME ZONE 'America/Sao_Paulo')::date)) AS \"antecedência média (dias)\",\n       round(100.0 * avg(cache_hit::int), 1) AS \"% do cache\"\nFROM searches WHERE $__timeFilter(requested_at)\nGROUP BY 1 ORDER BY 2 DESC LIMIT 10"
        }
